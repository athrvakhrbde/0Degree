{
  "functions": {
    "api/submit-email.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/lp.html",
      "has": [
        {
          "type": "host",
          "value": "lp.0degreeinc.com"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/lp.html",
      "has": [
        {
          "type": "host",
          "value": "lp.0degreeinc.com"
        }
      ]
    },
    {
      "source": "/join",
      "destination": "/join.html"
    },
    {
      "source": "/why",
      "destination": "/why.html"
    },
    {
      "source": "/thesis",
      "destination": "/thesis.html"
    },
    {
      "source": "/careers",
      "destination": "/careers.html"
    },
    {
      "source": "/lp",
      "destination": "/lp.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
